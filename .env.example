# Configuration du Data Engineering Agent

# ============================================
# OpenAI Configuration (Required)
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================
# Microsoft Fabric Configuration (Optional)
# Disabled by default. Set FABRIC_ENABLED=true to reactivate it.
# ============================================

FABRIC_ENABLED=false

# Your Fabric Workspace ID
# Find it in: https://app.fabric.microsoft.com/groups/{WORKSPACE_ID}
FABRIC_WORKSPACE_ID=your-workspace-id

# Lakehouse item ID (Fabric workspace -> Lakehouse -> URL or item details)
FABRIC_LAKEHOUSE_ID=your-lakehouse-id

# Azure Active Directory Tenant ID
# Find it in: https://portal.azure.com → Azure AD → Overview
FABRIC_TENANT_ID=your-azure-tenant-id

# Azure Application Client ID
# Create at: https://portal.azure.com → App registrations → New
FABRIC_CLIENT_ID=your-azure-client-id

# OAuth redirect URI: http://localhost:8000/api/fabric/callback
# The app must be configured as a public client; no client secret is needed.
FABRIC_REDIRECT_URI=http://localhost:8000/api/fabric/callback

# ============================================
# Agent Configuration (Optional)
# ============================================

# Debug mode (true/false)
DEBUG=false

# Log level (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO

# Maximum iterations for agent loop
MAX_AGENT_ITERATIONS=15

# Data directory paths
DATA_BRONZE_PATH=data/bronze
DATA_SILVER_PATH=data/silver
DATA_GOLD_PATH=data/gold
DATA_AUDIT_PATH=data/audit

# Default Fabric Dataset Name
FABRIC_DEFAULT_DATASET=sales_analysis

# Fabric Publishing Mode (incremental or full_refresh)
FABRIC_PUBLISH_MODE=incremental
